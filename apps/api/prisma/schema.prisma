generator client {
  provider        = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
}

enum Role {
  PASSENGER
  DRIVER
  BOTH
}

enum TripModel {
  A
  B
}

enum TripStatus {
  ACTIVE
  CONFIRMED
  CANCELLED
  COMPLETED
  THRESHOLD_NOT_MET
}

model User {
  id            String    @id
  phone         String?   @unique
  email         String?   @unique
  firstName     String
  lastName      String
  avatarUrl     String?
  role          Role      @default(PASSENGER)
  isVerified    Boolean   @default(false)
  isBanned      Boolean   @default(false)
  banExpiresAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  mobilepayNumber String?
  pushTokens      PushToken[]
  tripsAsDriver   Trip[]    @relation("DriverTrips")
  bookings        Booking[]
  ratingsGiven    Rating[]  @relation("RaterRatings")
  ratingsReceived Rating[]  @relation("RateeRatings")
  licence         DriverLicence?
  carDetails      CarDetails?
  notifications   Notification[]
  savedPlaces     SavedPlace[]
  recentSearches  RecentSearch[]
  chatMessages    ChatMessage[]
  searchAlerts        SearchAlert[]
  reportsSubmitted    UserReport[] @relation("ReporterReports")
  reportsReceived     UserReport[] @relation("ReportedReports")
  isAdmin             Boolean   @default(false)
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
}

model Trip {
  id            String   @id @default(uuid())
  driverId      String
  driver        User     @relation("DriverTrips", fields: [driverId], references: [id])
  originLat     Float
  originLng     Float
  originAddress String
  destLat       Float
  destLng       Float
  destAddress   String
  departureAt   DateTime
  seats         Int
  pricePerSeat  Int
  model             TripModel @default(A)
  status            TripStatus @default(ACTIVE)
  minPassengers     Int?
  thresholdDeadline DateTime?
  distanceKm        Float?
  recurringDays     String[]
  isRecurring       Boolean   @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings   Booking[]
}

model Booking {
  id          String   @id @default(uuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id])
  passengerId String
  passenger   User     @relation(fields: [passengerId], references: [id])
  seats       Int      @default(1)
  totalOere   Int
  status      BookingStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  settlement   RideSettlement?
  chatMessages ChatMessage[]
}

model Rating {
  id        String   @id @default(uuid())
  raterId   String
  rater     User     @relation("RaterRatings", fields: [raterId], references: [id])
  rateeId   String
  ratee     User     @relation("RateeRatings", fields: [rateeId], references: [id])
  score     Int
  comment   String?
  createdAt DateTime @default(now())
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
  AWAITING_PAYMENT
  COMPLETED
  DISPUTED
}

model RideSettlement {
  bookingId          String    @id
  booking            Booking   @relation(fields: [bookingId], references: [id])
  suggestedAmountOere Int
  mobilepayNumber    String
  passengerPaidAt    DateTime?
  driverConfirmedAt  DateTime?
  disputedAt         DateTime?
  disputeReason      String?
  createdAt          DateTime  @default(now())
}

model DriverLicence {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  frontUrl    String
  backUrl     String
  status      BookingStatus @default(PENDING)
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime @default(now())
}

model CarDetails {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  make          String
  model         String
  year          Int
  licensePlate  String
  colour        String
  seatsAvailable Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum NotificationType {
  NEW_BOOKING
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  TRIP_REMINDER
  NEW_RATING
  THRESHOLD_MET
  CHAT_MESSAGE
  SEARCH_ALERT
  RIDE_AWAITING_PAYMENT
  PAYMENT_MARKED_PAID
  PAYMENT_CONFIRMED
  PAYMENT_DISPUTED
  GENERAL
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType @default(GENERAL)
  title      String
  body       String
  isRead     Boolean          @default(false)
  deepLinkId String?
  createdAt  DateTime         @default(now())

  @@index([userId, isRead])
}

enum SavedPlaceKind {
  HOME
  WORK
  CUSTOM
}

/**
 * User-saved location for one-tap destination prefill on the home screen.
 * Lat/lng are optional so a user can save a free-text label like "Mum's place"
 * before geocoding lands.
 */
model SavedPlace {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  address   String
  lat       Float?
  lng       Float?
  kind      SavedPlaceKind @default(CUSTOM)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, createdAt])
  @@unique([userId, label])
}

/**
 * Persisted recent search rows surfaced on the home screen.
 * Upserted on every successful trip search so the most-recent timestamp wins
 * and the use-count grows for prioritisation.
 */
model RecentSearch {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originLabel String
  destLabel   String
  lastUsedAt  DateTime @default(now())
  useCount    Int      @default(1)

  @@unique([userId, originLabel, destLabel])
  @@index([userId, lastUsedAt])
}

/**
 * Real-time chat messages scoped to a booking.
 * Both the passenger and the driver of the booking's trip can send messages.
 * Messages are ordered by createdAt for history replay on reconnect.
 */
model ChatMessage {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

/**
 * Driver-set alert: notify the driver when a new trip matching their
 * saved origin/destination appears.
 */
model SearchAlert {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  origin    String
  dest      String
  seats     Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, origin, dest])
  @@index([isActive, origin, dest])
}

/**
 * User-submitted abuse report against another user.
 * Stored for admin review; does not auto-ban.
 */
model UserReport {
  id         String   @id @default(uuid())
  reporterId String
  reporter   User     @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId String
  reported   User     @relation("ReportedReports", fields: [reportedId], references: [id], onDelete: Cascade)
  reason     String
  createdAt  DateTime @default(now())

  @@index([reportedId])
  @@index([reporterId])
}
