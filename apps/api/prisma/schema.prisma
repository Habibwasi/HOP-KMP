generator client {
  provider        = "prisma-client-js"

}

datasource db {
  provider = "postgresql"

}

enum Role {
  PASSENGER
  DRIVER
  BOTH
}

enum TripModel {
  A
  B
}

enum TripStatus {
  ACTIVE
  CANCELLED
  COMPLETED
  THRESHOLD_NOT_MET
}

model User {
  id            String    @id
  phone         String?   @unique
  email         String?   @unique
  firstName     String
  lastName      String
  avatarUrl     String?
  role          Role      @default(PASSENGER)
  isVerified    Boolean   @default(false)
  isBanned      Boolean   @default(false)
  banExpiresAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pushTokens      PushToken[]
  tripsAsDriver   Trip[]    @relation("DriverTrips")
  bookings        Booking[]
  ratingsGiven    Rating[]  @relation("RaterRatings")
  ratingsReceived Rating[]  @relation("RateeRatings")
  taxRecords      TaxRecord[]
  licence         DriverLicence?
  carDetails      CarDetails?
  notifications   Notification[]
  isAdmin         Boolean   @default(false)
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
}

model Trip {
  id            String   @id @default(uuid())
  driverId      String
  driver        User     @relation("DriverTrips", fields: [driverId], references: [id])
  originLat     Float
  originLng     Float
  originAddress String
  destLat       Float
  destLng       Float
  destAddress   String
  departureAt   DateTime
  seats         Int
  pricePerSeat  Int
  model             TripModel @default(A)
  status            TripStatus @default(ACTIVE)
  minPassengers     Int?
  thresholdDeadline DateTime?
  distanceKm        Float?
  recurringDays     Int[]
  isRecurring       Boolean   @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings   Booking[]
  taxRecords TaxRecord[]
}

model Booking {
  id          String   @id @default(uuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id])
  passengerId String
  passenger   User     @relation(fields: [passengerId], references: [id])
  seats       Int      @default(1)
  totalOere   Int
  status      BookingStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payment     Payment?
  taxRecord   TaxRecord?
}

model Rating {
  id        String   @id @default(uuid())
  raterId   String
  rater     User     @relation("RaterRatings", fields: [raterId], references: [id])
  rateeId   String
  ratee     User     @relation("RateeRatings", fields: [rateeId], references: [id])
  score     Int
  comment   String?
  createdAt DateTime @default(now())
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MOBILEPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  HELD
  CAPTURED
  REFUNDED
  FAILED
}

model Payment {
  id          String          @id @default(uuid())
  bookingId   String          @unique
  booking     Booking         @relation(fields: [bookingId], references: [id])
  amountOere  Int
  provider    PaymentProvider
  status      PaymentStatus   @default(PENDING)
  providerRef String?
  webhookData Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TaxRecord {
  id          String   @id @default(uuid())
  driverId    String
  driver      User     @relation(fields: [driverId], references: [id])
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id])
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id])
  amountOere  Int
  distanceKm  Float
  ratePerKm   Float
  recordedAt  DateTime @default(now())
}

model DriverLicence {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  frontUrl    String
  backUrl     String
  status      BookingStatus @default(PENDING)
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime @default(now())
}

model CarDetails {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  make          String
  model         String
  year          Int
  licensePlate  String
  colour        String
  seatsAvailable Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  TRIP_REMINDER
  NEW_RATING
  THRESHOLD_MET
  CHAT_MESSAGE
  GENERAL
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType @default(GENERAL)
  title      String
  body       String
  isRead     Boolean          @default(false)
  deepLinkId String?
  createdAt  DateTime         @default(now())
}
