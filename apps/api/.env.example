# =============================================================================
# Hop API — environment variables
# Copy to .env for local development.
# In production, configure these in Railway service variables.
# =============================================================================

# --- Database (Supabase Postgres) ---
# Pooled connection (PgBouncer, port 6543) — used by the running app.
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://hop:hop_secret@localhost:5432/hop_db"
# Direct connection (port 5432) — used by `prisma migrate` only.
# Format: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DIRECT_URL="postgresql://hop:hop_secret@localhost:5432/hop_db"

# --- Redis (BullMQ) ---
# In production (Railway), set REDIS_URL (e.g. ${{Redis.REDIS_URL}}).
# Locally, the docker-compose Redis is reached via host/port.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- App ---
PORT=3000
NODE_ENV=development

# --- Supabase Auth ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Twilio (OTP) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- MobilePay ---
MOBILEPAY_CLIENT_ID=
MOBILEPAY_CLIENT_SECRET=
MOBILEPAY_MERCHANT_VAT=
MOBILEPAY_WEBHOOK_SECRET=

# --- Stripe (fallback) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- APNs (iOS push) ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=dk.hop.app
APNS_KEY_PATH=./apns.p8

# --- FCM (Android push) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Google Maps ---
MAPS_API_KEY=

# --- Admin bootstrap ---
ADMIN_SECRET=

# --- Legacy JWT (if still used by older code paths) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=365d
