---
import '@fontsource/syne/700.css'
import '@fontsource/syne/800.css'
import '@fontsource-variable/dm-sans'
import '@fontsource/nunito/900.css'
import '../styles/global.css'
import type { Dict } from '../i18n/da'

interface Props {
  t: Dict
}

const { t } = Astro.props
const site = 'https://ridly.dk'
const url = new URL(t.path, site).href
const ogImage = new URL('/media/ridly-film-poster.jpg', site).href
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#0B0B0B" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="da" href={`${site}/`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ridly" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:locale" content={t.lang === 'da' ? 'da_DK' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js')</script>
    {import.meta.env.PROD && <script defer src="/_vercel/insights/script.js" />}
  </head>
  <body>
    <slot />
  </body>
</html>
