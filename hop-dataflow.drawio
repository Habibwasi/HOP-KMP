        <!-- RoutingRepo -->
        <mxCell id="repo-routing" value="&lt;b&gt;RoutingRepositoryImpl&lt;/b&gt;&#xa;GET places/route?origin&amp;dest&#xa;→ Backend calls Mapbox Directions&#xa;Returns: {distanceMetres,&#xa;originLat/Lng, destLat/Lng}" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="620" width="230" height="75" as="geometry" />
