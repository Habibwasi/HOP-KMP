        <mxCell id="ui-trip-create" value="&lt;b&gt;Trip Creation Screen (Driver)&lt;/b&gt;&#xa;origin/dest address, departureAt,&#xa;seats, pricePerSeat, model(A/B),&#xa;minPassengers, thresholdDeadline,&#xa;recurringDays, distanceKm" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
