        <!-- ═══════════════════════════════════════════════════════════ -->
        <!--  ① AUTH FLOW                                                -->
        <!-- ═══════════════════════════════════════════════════════════ -->

        <!-- UI: Login / Register Screen -->
        <mxCell id="ui-auth" value="&lt;b&gt;Login / Register Screen&lt;/b&gt;&#xa;User enters: email, password,&#xa;firstName, lastName, phone" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ViewModel: AuthViewModel -->
        <mxCell id="vm-auth" value="&lt;b&gt;AuthViewModel&lt;/b&gt;&#xa;AuthEvent.Register / Login&#xa;AuthEvent.RestoreSession&#xa;AuthEffect → NavigateToHome" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="100" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Repo: SupabaseAuthRepositoryImpl -->
        <mxCell id="repo-auth" value="&lt;b&gt;SupabaseAuthRepositoryImpl&lt;/b&gt;&#xa;register() / login() / logout()&#xa;restoreSession() / handleDeepLink()&#xa;updatePassword()" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="95" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- Ktor HttpClient -->
        <mxCell id="http-client" value="&lt;b&gt;Ktor HttpClient&lt;/b&gt;&#xa;AuthInterceptor: injects&#xa;Bearer {supabase.accessToken}&#xa;Base: https://hop.ridly.dk/api/v1&#xa;Timeout: 30s / Retry: 2x exp-backoff" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="90" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- TokenStorage (local) -->
        <mxCell id="token-storage" value="&lt;b&gt;TokenStorage (Local)&lt;/b&gt;&#xa;Android: EncryptedSharedPreferences&#xa;(AES-256-GCM)&#xa;iOS: Keychain&#xa;Stores: accessToken, refreshToken,&#xa;recoveryPending flag" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="170" y="250" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- Supabase Auth -->
        <mxCell id="supabase-auth" value="&lt;b&gt;Supabase Auth&lt;/b&gt;&#xa;signUpWith(Email)&#xa;signInWith(Email)&#xa;auth.getUser(token)&#xa;Returns: JWT accessToken + session&#xa;Redirect: ridly://auth/callback" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2220" y="95" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- Backend: SupabaseGuard -->
        <mxCell id="guard" value="&lt;b&gt;SupabaseGuard&lt;/b&gt;&#xa;Validates Bearer JWT&#xa;via supabase.auth.getUser()&#xa;Auto-creates Prisma profile&#xa;from user_metadata if missing" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1130" y="95" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Backend: UsersController POST /users/profile -->
        <mxCell id="ctrl-profile" value="&lt;b&gt;UsersController&lt;/b&gt;&#xa;POST /users/profile&#xa;Body: {firstName, lastName, phone, email}&#xa;→ UsersService.createProfile()&#xa;→ Prisma User.create()" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1400" y="95" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Backend: UsersController GET /users/me -->
        <mxCell id="ctrl-me" value="&lt;b&gt;UsersController&lt;/b&gt;&#xa;GET /users/me&#xa;→ UsersService.findMe()&#xa;→ Prisma User.findUnique()&#xa;Returns: UserDto" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1680" y="95" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- DB: PostgreSQL (User) -->
        <mxCell id="db-user" value="&lt;b&gt;PostgreSQL – User&lt;/b&gt;&#xa;id, email, phone, firstName,&#xa;lastName, role, mobilepayNumber,&#xa;isVerified, isBanned, isAdmin" style="shape=cylinder3;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1960" y="90" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- SessionExpiryNotifier -->
        <mxCell id="session-notifier" value="&lt;b&gt;SessionExpiryNotifier&lt;/b&gt;&#xa;401 → notifyExpired()&#xa;AuthViewModel emits&#xa;AuthEffect.SessionExpired&#xa;→ Navigate to Login" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
