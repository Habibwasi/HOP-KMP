        <!-- SearchHistory -->
        <mxCell id="repo-search-hist" value="&lt;b&gt;SearchHistoryRepositoryImpl&lt;/b&gt;&#xa;GET search-history&#xa;POST search-history&#xa;DELETE search-history/{id}&#xa;→ DB RecentSearch table" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
